{
  "name": "credit-card-validator",
  "version": "1.0.0",
  "description": "Виджет для валидации номеров кредитных карт",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "node ./e2e/test.js",
    "lint": "eslint src/js/**/*.js",
    "lint:fix": "eslint src/js/**/*.js --fix",
    "deploy": "mail -d dist",
    "predeploy": "npm run build"
  },
  "keywords": [
    "credit-card",
    "validator",
    "luhn",
    "payment-systems"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "puppeteer": "^24.34.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "gh-pages": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["<rootDir>/src/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "src/js/**/*.js",
      "!src/js/index.js"
    ],
    "coverageDirectory": "coverage",
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|svg)$": "<rootDir>/src/tests/__mocks__/fileMock.js",
      "\\.(css|scss)$": "<rootDir>/src/tests/__mocks__/styleMock.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/",
      "\\.(jpg|jpeg|png|gif|svg)$"
    ]
  }
}
